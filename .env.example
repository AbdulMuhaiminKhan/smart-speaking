# Copy to .env and adjust. All values are optional.

# Whisper size for each speed preset is fixed in code; this picks the default preset.
SS_DEFAULT_PRESET=balanced
# auto | cpu | cuda
SS_WHISPER_DEVICE=auto

# Local LLM for the coaching report (Phase 5). On a Mac, run Ollama natively.
SS_OLLAMA_URL=http://host.docker.internal:11434
SS_OLLAMA_MODEL=qwen2.5:7b

# Upload limits
SS_MAX_UPLOAD_BYTES=2147483648
SS_MAX_DURATION_S=930
